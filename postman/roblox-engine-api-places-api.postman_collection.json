  "info": {
    "_postman_id": "39c13dcc-88f2-44ea-a0a3-1485a5fe8483",
    "name": "Roblox Open Cloud Assets Places API",
    "description": "The Roblox Open Cloud API provides external programmatic access to Roblox platform resources. It enables server-side operations on experiences, places, data stores, memory stores, users, groups, assets, messaging, badges, game passes, and subscriptions. Authentication uses API keys scoped to specific resources. The API is organized into Open Cloud v2, v1, and Legacy tiers with consistent RESTful patterns.\n\nContact Support:\n Name: Roblox Developer Relations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:48:46.000Z",
    "updatedAt": "2026-07-28T02:48:47.000Z",
